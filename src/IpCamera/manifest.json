{
  "$schema": "https://schemas.macro-deck.app/plugin-manifest-v1.schema.json",
  "manifestVersion": 1,
  "id": "com.itaimarom.ip-camera",
  "name": "IP Camera",
  "version": "1.5.2",
  "description": "Shows live IP camera streams on Macro Deck widgets: RTSP through ffmpeg, HTTP MJPEG and snapshot cameras, including Xiaomi Mi 360 cameras behind go2rtc.",
  "icon": "Assets/icon.svg",
  "entrypoints": {
    "win-x64": {
      "executable": "runtimes/win-x64/IpCamera.dll",
      "runtime": {
        "kind": "FrameworkDependent",
        "dotnetVersion": "10.0"
      }
    },
    "osx-arm64": {
      "executable": "runtimes/osx-arm64/IpCamera.dll",
      "runtime": {
        "kind": "FrameworkDependent",
        "dotnetVersion": "10.0"
      }
    },
    "linux-x64": {
      "executable": "runtimes/linux-x64/IpCamera.dll",
      "runtime": {
        "kind": "FrameworkDependent",
        "dotnetVersion": "10.0"
      }
    }
  },
  "publisher": {
    "name": "ItaiMarom"
  },
  "license": "Apache-2.0",
  "repository": "https://github.com/dominic25/ItaiMarom.IpCameraPlugin",
  "permissions": [
    "host:video-streams"
  ],
  "ai": {
    "interaction": false,
    "generatedContent": false,
    "generatedAssets": true
  },
  "compatibility": {
    "macroDeck": ">=3.0.0-0"
  }
}